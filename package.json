{
  "name": "pr-pokemon-finder",
  "version": "0.0.2",
  "private": true,
  "displayName": "PR Pokémon Finder",
  "publisher": "john-tavares",
  "description": "Connect your GitHub account to PR Pokémon Finder inside VS Code.",
  "preview": true,
  "categories": [
    "Other"
  ],
  "main": "./out/src/extension.js",
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "configuration": {
      "title": "PR Pokémon Finder",
      "properties": {
        "prPokemonFinder.presentation.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Automatically show retro encounter/capture scenes after new PR captures are saved. Disabling does not stop captures; use Show Pending Capture Animations manually."
        },
        "prPokemonFinder.presentation.remoteArtwork": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Load Pokémon sprites from raw.githubusercontent.com/PokeAPI/sprites at runtime. Sends only the species number (never tokens or PR metadata); cached in memory. Disable for an offline text/silhouette fallback. Image rights remain with their owners."
        },
        "prPokemonFinder.presentation.reducedMotion": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "Show the capture result without animated movement. OS and VS Code reduced-motion preferences are also respected."
        },
        "prPokemonFinder.polling.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Automatically check authored PRs while the extension is active and signed in."
        },
        "prPokemonFinder.polling.intervalSeconds": {
          "type": "integer",
          "default": 60,
          "minimum": 60,
          "maximum": 3600,
          "scope": "application",
          "description": "Delay after a completed check before the next check. Rate limits can extend this delay."
        },
        "prPokemonFinder.includePrivateRepositories": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "markdownDescription": "Include private repositories in authored PR discovery. Requires native GitHub authorization for the broad `repo` scope. Use **PR Pokémon Finder: Enable Private Repository Access** to consent. Disabling this setting does not revoke existing GitHub permissions; manage those in Accounts."
        }
      }
    },
    "commands": [
      {
        "command": "prPokemonFinder.browseRepositoryCaptures",
        "title": "Browse Repository Captures",
        "category": "PR Pokémon Finder"
      },
      {
        "command": "prPokemonFinder.showNetworkPolicy",
        "title": "Show Network and Privacy Policy",
        "category": "PR Pokémon Finder"
      },
      {
        "command": "prPokemonFinder.showCollectionStatus",
        "title": "Show Local Collection Status",
        "category": "PR Pokémon Finder"
      },
      {
        "command": "prPokemonFinder.previewCaptureAnimation",
        "title": "Preview Capture Animation",
        "category": "PR Pokémon Finder"
      },
      {
        "command": "prPokemonFinder.showCaptureAnimations",
        "title": "Show Pending Capture Animations",
        "category": "PR Pokémon Finder"
      },
      {
        "command": "prPokemonFinder.showMonitoringStatus",
        "title": "Show Monitoring Status",
        "category": "PR Pokémon Finder"
      },
      {
        "command": "prPokemonFinder.pollNow",
        "title": "Check for New Pull Requests Now",
        "category": "PR Pokémon Finder"
      },
      {
        "command": "prPokemonFinder.showPendingEncounters",
        "title": "Show Pending Capture Presentations",
        "category": "PR Pokémon Finder"
      },
      {
        "command": "prPokemonFinder.discoverPullRequests",
        "title": "Discover My Pull Requests",
        "category": "PR Pokémon Finder"
      },
      {
        "command": "prPokemonFinder.enablePrivateRepositories",
        "title": "Enable Private Repository Access",
        "category": "PR Pokémon Finder"
      },
      {
        "command": "prPokemonFinder.checkGitHubConnection",
        "title": "Check GitHub API Connection",
        "category": "PR Pokémon Finder"
      },
      {
        "command": "prPokemonFinder.inspectPullRequest",
        "title": "Inspect Pull Request",
        "category": "PR Pokémon Finder"
      },
      {
        "command": "prPokemonFinder.signIn",
        "title": "Sign in to GitHub",
        "category": "PR Pokémon Finder"
      },
      {
        "command": "prPokemonFinder.showAuthenticationStatus",
        "title": "Show Authentication Status",
        "category": "PR Pokémon Finder"
      }
    ]
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/john-tavares/pr-pokemon-finder.git"
  },
  "engines": {
    "node": ">=24 <25",
    "vscode": "^1.95.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "check": "pnpm format:check && pnpm lint:md && pnpm test:tooling && pnpm test:unit",
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "test:unit": "pnpm build && node --test out/test/unit/*.test.js",
    "test:extension": "pnpm build && node scripts/test-extension.mjs",
    "package": "pnpm build && node -e \"require('node:fs').mkdirSync('dist', {recursive: true})\" && vsce package --no-dependencies --githubBranch master --out dist/pr-pokemon-finder.vsix && node scripts/verify-vsix.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:md": "markdownlint-cli2",
    "test:tooling": "node --test scripts/*.test.mjs",
    "check:pr-title": "node scripts/check-pr-title.mjs"
  },
  "devDependencies": {
    "@types/node": "20.19.0",
    "@types/vscode": "1.95.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.0",
    "markdownlint-cli2": "0.24.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  }
}
